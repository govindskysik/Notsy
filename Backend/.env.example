# Do not commit a real .env file or any credentials.
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=replace_with_a_long_random_secret
JWT_LIFETIME=1d

# Comma-separated allowed client origins. Use the HTTPS Vercel URL on Render.
FRONTEND_URL=http://localhost:5173,https://notsy-one.vercel.app

# AI provider credentials belong in notsy/.env; see notsy/.env.example.
